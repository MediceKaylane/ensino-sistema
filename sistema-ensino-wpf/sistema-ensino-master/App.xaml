<Application x:Class="sistema_ensino.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="view/LoginForm.xaml">
    <Application.Resources>
        <Style TargetType="Window" x:Key="JanelaPortal">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#F1F5FA"/>
            <Setter Property="Foreground" Value="#172645"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <Style TargetType="Button" x:Key="BotaoPortal">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#3155BE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value=".86"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="#F9B850"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value=".55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="BotaoSuave" BasedOn="{StaticResource BotaoPortal}">
            <Setter Property="Background" Value="#EDF2FF"/>
            <Setter Property="Foreground" Value="#25469E"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RotuloPortal">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>
        <Style TargetType="TextBox" x:Key="EntradaTexto">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="#ABBAD4"/>
            <Setter Property="MinHeight" Value="37"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="EntradaSenha">
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="BorderBrush" Value="#ABBAD4"/>
            <Setter Property="MinHeight" Value="37"/>
        </Style>
    </Application.Resources>
</Application>
